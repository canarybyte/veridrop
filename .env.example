# Copy to .env and fill in your values
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Optional: trusted upstream used to cryptographically verify thinking signatures
# returned by the relay (see README "签名上游验证"). Leave unset for shape-check only.
VERIDROP_ANTHROPIC_VERIFY_BASE_URL=
VERIDROP_ANTHROPIC_VERIFY_API_KEY=
VERIDROP_ANTHROPIC_VERIFY_MODEL=
