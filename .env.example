# Copy to .env and fill in your values
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Web 控制台（/app）检测结果存储；不填默认 SQLite: ./web_data/veridrop.db
# Postgres 示例: postgresql+asyncpg://user:pass@localhost:5432/veridrop
# DATABASE_URL=sqlite+aiosqlite:///./web_data/veridrop.db

# 外部 agent 只读分析 API（/api/v1/*）的密钥；不配置则该组接口返回 503
# VERIDROP_AGENT_API_KEY=change-me

# 凭据库（/app/api/credentials）中 API Key 的加密主密钥，Fernet key（44 字符）。
# 生成方式：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 不配置则自动读取/生成 VERIDROP_SECRET_FILE 指定的本地密钥文件。
# VERIDROP_SECRET_KEY=
# 本地密钥文件路径；仅在未设置 VERIDROP_SECRET_KEY 时生效，默认 web_data/secret.key
# VERIDROP_SECRET_FILE=web_data/secret.key
